/**
 * Vercel Function: envía correos de asignación mediante Resend.
 *
 * Variables requeridas en Vercel:
 * - RESEND_API_KEY
 * - SUPABASE_URL
 * - SUPABASE_PUBLISHABLE_KEY
 *
 * Opcional:
 * - EMAIL_FROM (por defecto: Fútbol XL Studio <onboarding@resend.dev>)
 */

function escapeHtml(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function formatTargetDate(value) {
  if (!value) return 'Sin fecha definida';
  const date = new Date(`${value}T12:00:00`);
  if (Number.isNaN(date.getTime())) return String(value);
  return new Intl.DateTimeFormat('es-AR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  }).format(date);
}

module.exports = async function handler(req, res) {
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'POST');
    return res.status(405).json({ error: 'Método no permitido.' });
  }

  const resendKey = process.env.RESEND_API_KEY;
  const supabaseUrl = process.env.SUPABASE_URL;
  const supabaseKey = process.env.SUPABASE_PUBLISHABLE_KEY;

  if (!resendKey || !supabaseUrl || !supabaseKey) {
    return res.status(500).json({ error: 'Faltan variables de entorno para enviar correos.' });
  }

  const authorization = req.headers.authorization || '';
  if (!authorization.startsWith('Bearer ')) {
    return res.status(401).json({ error: 'Sesión no válida.' });
  }

  try {
    const authResponse = await fetch(`${supabaseUrl.replace(/\/$/, '')}/auth/v1/user`, {
      headers: {
        apikey: supabaseKey,
        Authorization: authorization,
      },
    });

    if (!authResponse.ok) {
      return res.status(401).json({ error: 'No se pudo validar la sesión.' });
    }

    const body = typeof req.body === 'string' ? JSON.parse(req.body) : (req.body || {});
    const {
      to,
      employeeName,
      videoTitle,
      stateName,
      targetDate,
      assignedBy,
      appUrl,
    } = body;

    if (!to || !/^\S+@\S+\.\S+$/.test(String(to))) {
      return res.status(400).json({ error: 'El responsable no tiene un email válido.' });
    }

    const safeEmployee = escapeHtml(employeeName || 'integrante del equipo');
    const safeTitle = escapeHtml(videoTitle || 'Video sin título');
    const safeState = escapeHtml(stateName || 'Sin estado');
    const safeAssignedBy = escapeHtml(assignedBy || 'Fútbol XL Studio');
    const safeDate = escapeHtml(formatTargetDate(targetDate));
    const safeAppUrl = /^https?:\/\//i.test(String(appUrl || '')) ? String(appUrl) : '';

    const html = `
      <div style="background:#0a0a0a;padding:32px 16px;font-family:Arial,sans-serif;color:#f5f5f5">
        <div style="max-width:600px;margin:0 auto;background:#171719;border:1px solid #2d2d31;border-radius:16px;overflow:hidden">
          <div style="padding:26px 28px;border-bottom:1px solid #2d2d31">
            <div style="font-size:13px;color:#9ca3af;letter-spacing:.08em;text-transform:uppercase">Fútbol XL Studio</div>
            <h1 style="font-size:24px;line-height:1.25;margin:10px 0 0;color:#ffffff">Nuevo proyecto asignado</h1>
          </div>
          <div style="padding:28px">
            <p style="font-size:16px;line-height:1.6;margin:0 0 22px">Hola <strong>${safeEmployee}</strong>, se te asignó un nuevo proyecto.</p>
            <div style="background:#101012;border-radius:12px;padding:18px 20px;margin-bottom:22px">
              <div style="font-size:12px;color:#9ca3af;text-transform:uppercase;margin-bottom:5px">Video</div>
              <div style="font-size:18px;font-weight:700;margin-bottom:18px">${safeTitle}</div>
              <div style="font-size:12px;color:#9ca3af;text-transform:uppercase;margin-bottom:5px">Estado</div>
              <div style="font-size:15px;margin-bottom:18px">${safeState}</div>
              <div style="font-size:12px;color:#9ca3af;text-transform:uppercase;margin-bottom:5px">Fecha objetivo</div>
              <div style="font-size:15px">${safeDate}</div>
            </div>
            ${safeAppUrl ? `<a href="${escapeHtml(safeAppUrl)}" style="display:inline-block;background:#3b82f6;color:#fff;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:9px">Abrir Fútbol XL Studio</a>` : ''}
            <p style="font-size:13px;color:#8b8b93;line-height:1.5;margin:24px 0 0">Asignado por ${safeAssignedBy}.</p>
          </div>
        </div>
      </div>`;

    const resendResponse = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${resendKey}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        from: process.env.EMAIL_FROM || 'Fútbol XL Studio <onboarding@resend.dev>',
        to: [String(to)],
        subject: `🎬 Nuevo video asignado: ${String(videoTitle || 'Sin título')}`,
        html,
      }),
    });

    const resendResult = await resendResponse.json().catch(() => ({}));
    if (!resendResponse.ok) {
      const message = resendResult?.message || resendResult?.error || 'Resend rechazó el envío.';
      return res.status(resendResponse.status).json({ error: message });
    }

    return res.status(200).json({ ok: true, id: resendResult.id || null });
  } catch (error) {
    console.error('[send-assignment-email]', error);
    return res.status(500).json({ error: 'Ocurrió un error al enviar el correo.' });
  }
};
